# Biến của chồng prod (docker-compose.prod.yml, D-103). Chép thành .env.prod rồi điền. Không commit
# .env.prod. Cách tạo từng giá trị: docs/runbook.md, mục Deploy. Ô bỏ trống thì dùng mặc định ghi
# trong docker-compose.prod.yml.

# Token của named tunnel Cloudflare (bảng Zero Trust → Networks → Tunnels). Bắt buộc.
CLOUDFLARE_TUNNEL_TOKEN=
# Mật khẩu Neo4j prod: chữ và số ngẫu nhiên, đủ dài (backend kiểm lúc khởi động). Bắt buộc.
NEO4J_PASSWORD=
# Mật khẩu Postgres prod: chữ và số ngẫu nhiên (nằm trong URL kết nối), đủ dài. Bắt buộc.
POSTGRES_PASSWORD=
# Khoá Fernet mã hoá key OpenRouter của người chơi (G7). Mất khoá thì key đã lưu không đọc được. Bắt buộc.
PLAYER_KEY_ENCRYPTION_KEY=

# Tuỳ chọn. Link công khai của tunnel (vd https://writory.example.com), deploy\prod-up.ps1 in ra.
PUBLIC_URL=
# Tuỳ chọn. Bộ nhớ Neo4j prod (heap, pagecache), vd 512m.
NEO4J_HEAP=
NEO4J_PAGECACHE=
# Tuỳ chọn. Mạng edge và IP cố định của proxy, cloudflared; chỉ đổi khi trùng mạng khác trên máy.
EDGE_SUBNET=
PROXY_IP=
TUNNEL_IP=
# Tuỳ chọn. Địa chỉ Caddy nghe; trống là :80 (sau tunnel). Tên miền: phụ lục "IP công khai" của runbook.
SITE_ADDRESS=
# Tuỳ chọn, chỉ cho deploy/docker-compose.localtest.yml: cổng 127.0.0.1 khi thử trên máy.
LOCALTEST_PORT=
