# Chép thành .env rồi điền. Không commit .env.
# Key của chủ dự án, chỉ cho bộ đo (docs/eval.md). Người chơi dùng key riêng (D-2).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Tuỳ chọn: cần khi key Anthropic không gắn với workspace (lỗi 400 đòi anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local
POSTGRES_DSN=postgresql://writory:change-me-local@localhost:5432/writory
POSTGRES_PASSWORD=change-me-local
# Khoá Fernet mã hoá key OpenRouter của người chơi (G7). Cách tạo: docs/runbook.md
PLAYER_KEY_ENCRYPTION_KEY=
# Gắn router chưa có đăng nhập (truyện, key người chơi; D-41). Chỉ bật trên máy dev.
ENABLE_DEV_ROUTES=false
