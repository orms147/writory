   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Phó Minh Nghi",
      "personality": "Lanh lợi, giỏi ứng đối và luôn giữ vẻ hòa nhã ngay cả khi bị chất vấn. Nàng sẵn sàng mặc cả để sống sót, nhưng rất nhạy bén với những lời hứa có thể trở thành cái bẫy.",
      "backstory": "Phó Minh Nghi là con gái của một tu sĩ tán tu, được nhận vào Bích Tiêu Môn rồi phái đến Hàn Tê làm người giữ kiếm cụ trong cuộc luận kiếm. Nàng mang theo một bản ghi chép về những lần bàn giao pháp khí, thứ có thể giúp làm rõ ai đã ra vào khu vực trước khi chấp sự qua đời. Sau khi phù lệnh xuất hiện trong tay nàng, vài đệ tử lập tức muốn giữ nàng lại để thẩm vấn, còn những người khác kín đáo đề nghị đổi bản ghi lấy một con đường xuống núi.",
      "is_protagonist": true,
      "user_authored": true
     }
    },
    {
     "id": "luong_khac",
     "label": "Character",
     "props": {
      "name": "Lương Khắc",
      "aliases": [
       "chấp sự Lương"
      ],
      "personality": "Cẩn trọng, kín tiếng, quen giữ vẻ công bằng nhưng thường để người khác tự nói hớ trước khi kết luận.",
      "backstory": "Chấp sự của Bích Tiêu Môn, được giao điều phối cuộc luận kiếm và ghi nhận thỏa thuận khai thác linh mạch; ông đã chết trong căn phòng khóa kín trước khi đài mở."
     }
    },
    {
     "id": "diep_tinh_lan",
     "label": "Character",
     "props": {
      "name": "Diệp Tĩnh Lan",
      "aliases": [
       "Tĩnh Lan"
      ],
      "personality": "Điềm đạm, giỏi lựa lời, luôn tỏ ra đứng về lẽ phải nhưng hiếm khi nói điều gì mà không tính trước lợi ích.",
      "backstory": "Đệ tử thân truyền của Huyền Sương Cốc, được cử đến Hàn Tê làm người giám sát cuộc luận kiếm; nàng có quyền tiếp cận các khu vực mà đệ tử thường không được vào."
     }
    },
    {
     "id": "doan_khuong",
     "label": "Character",
     "props": {
      "name": "Đoàn Khương",
      "aliases": [
       "Đoàn sư huynh"
      ],
      "personality": "Nóng nảy, thẳng ruột ngựa, dễ bị kích động bởi lời thách thức nhưng không thích ra tay với người đã chịu khuất phục.",
      "backstory": "Đệ tử của Liệt Dương Kiếm Tông, được giao dẫn nhóm canh giữ lối lên đỉnh; anh tin rằng người mang phù lệnh đáng ngờ phải bị giữ lại cho đến khi tra rõ."
     }
    },
    {
     "id": "van_hoai",
     "label": "Character",
     "props": {
      "name": "Văn Hoài",
      "personality": "Lặng lẽ, quan sát kỹ, nói năng dè sẻn và có thói quen cân nhắc xem mỗi lời khai sẽ khiến ai gặp nguy hiểm.",
      "backstory": "Đệ tử cấp thấp của Bích Tiêu Môn, phụ trách chuyển vật dụng giữa kho kiếm cụ và sân luận kiếm; anh từng thấy người ra vào khu vực phòng chấp sự nhưng chưa dám lên tiếng."
