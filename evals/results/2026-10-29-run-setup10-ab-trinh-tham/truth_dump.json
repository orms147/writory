   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Phạm Quang Vinh",
      "personality": "Lặng lẽ, thực tế và hơi đa nghi; Vinh quen quan sát trước khi lên tiếng. Anh ít tin vào tin đồn, nhưng một khi nhận ra chi tiết không hợp lý thì bám theo đến cùng.",
      "backstory": "Vinh làm thợ sửa điện, thường được gọi đến kiểm tra dây dẫn và ổ cắm trong khu tập thể. Anh từng sửa chiếc đài ở căn cuối dãy nên biết âm thanh của nó, cũng như thói quen người thuê căn hộ khóa cửa khi ra ngoài. Tiếng gõ lúc chạng vạng và ổ khóa nằm phía ngoài khiến Vinh nghi có người đã can thiệp vào căn phòng. Ban quản lý muốn mọi chuyện lắng xuống, còn vài món đồ công cộng biến mất khiến anh càng muốn tự tìm lời giải.",
      "is_protagonist": true,
      "user_authored": true,
      "appearance": "Gương mặt trái xoan, mũi thẳng, vóc người tầm thước ở tuổi ngoài ba mươi. Tóc đen cắt gọn, áo sơ mi xám nhạt bằng vải bông và đôi mắt sâu dưới hàng mày rậm."
     }
    },
    {
     "id": "tran_duc_lam",
     "label": "Character",
     "props": {
      "name": "Trần Đức Lâm",
      "aliases": [
       "Lâm ở căn cuối dãy"
      ],
      "personality": "Kín tiếng, cẩn thận, không thích nợ ai; khi bị dồn ép thường tìm cách ghi lại những điều mình thấy.",
      "backstory": "Thuê căn hộ cuối dãy đã nhiều năm. Gần đây, ông phát hiện một số đồ dùng ở phòng sinh hoạt chung bị lấy đi và bắt đầu hỏi han về việc quản lý chìa khóa.",
      "appearance": "Gương mặt dài, gò má cao và dáng người gầy ở tuổi ngoài bốn mươi. Tóc nâu sẫm chải lệch, áo sơ mi xanh bạc màu cùng chiếc nhẫn bạc trơn ở ngón áp út."
     }
    },
    {
     "id": "nguyen_thi_hao",
     "label": "Character",
     "props": {
      "name": "Nguyễn Thị Hảo",
      "aliases": [
       "cô Hảo"
      ],
      "personality": "Kiệm lời, dè dặt và coi trọng trật tự; thường cân nhắc kỹ trước khi trả lời những câu hỏi trực tiếp.",
      "backstory": "Đã phụ trách sổ sách và chìa khóa chung của khu tập thể nhiều năm. Bà biết rõ những bất hòa nhỏ giữa các hộ nhưng ít khi đứng về phía nào.",
      "appearance": "Khuôn mặt tròn, mắt nhỏ, vóc người thấp và chắc ở tuổi ngoài năm mươi. Tóc hoa râm cuộn thành búi thấp, áo cánh nâu sẫm bằng vải thô và chiếc kính gọng kim loại vuông."
     }
    },
    {
     "id": "bui_van_tan",
     "label": "Character",
     "props": {
      "name": "Bùi Văn Tấn",
      "aliases": [
       "anh Tấn"
      ],
      "personality": "Nhanh miệng, hay sốt ruột và dễ đổi giọng khi bị hỏi đến chuyện riêng.",
      "backstory": "Sống cùng dãy với Lâm, làm việc theo ca nên có những buổi về nhà muộn. Tấn từng mượn đồ ở phòng sinh hoạt chung và có lời qua tiếng lại với Lâm về chuyện đó.",
      "appearance": "Mặt vuông, cằm rộng, thân hình vạm vỡ ở tuổi ngoài ba mươi. Tóc đỏ sẫm cắt ngắn, chiếc áo khoác xanh công nhân sờn khuỷu tay và vết sẹo mảnh chạy ngang cằm."
