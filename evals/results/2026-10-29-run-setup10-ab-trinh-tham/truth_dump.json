   "nguyen_thi_hao": {
    "label": "Character",
    "props": {
     "backstory": "Đã phụ trách sổ sách và chìa khóa chung của khu tập thể nhiều năm. Bà biết rõ những bất hòa nhỏ giữa các hộ nhưng ít khi đứng về phía nào.",
     "appearance": "Khuôn mặt tròn, mắt nhỏ, vóc người thấp và chắc ở tuổi ngoài năm mươi. Tóc hoa râm cuộn thành búi thấp, áo cánh nâu sẫm bằng vải thô và chiếc kính gọng kim loại vuông.",
     "aliases": [
      "cô Hảo"
     ],
     "personality": "Kiệm lời, dè dặt và coi trọng trật tự; thường cân nhắc kỹ trước khi trả lời những câu hỏi trực tiếp.",
