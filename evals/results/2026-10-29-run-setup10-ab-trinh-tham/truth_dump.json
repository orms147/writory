   },
   "phong_truc_ban_quan_ly": {
    "label": "Location",
    "props": {
     "aliases": [
      "phòng trực"
     ],
     "name": "Phòng trực ban quản lý",
     "visual": "Ánh sáng ban ngày yếu ớt xuyên qua cửa sổ chớp, đọng trên mặt bàn phủ giấy tờ. Tủ gỗ cũ có những móc chìa khóa lấp ló trong bóng tối.",
     "description": "Gian phòng nhỏ cạnh cầu thang, có bàn ghi sổ và tủ chìa khóa."
    }
   },
   "protagonist": {
    "label": "Character",
    "props": {
     "user_authored": true,
     "backstory": "Vinh làm thợ sửa điện, thường được gọi đến kiểm tra dây dẫn và ổ cắm trong khu tập thể. Anh từng sửa chiếc đài ở căn cuối dãy nên biết âm thanh của nó, cũng như thói quen người thuê căn hộ khóa cửa khi ra ngoài. Tiếng gõ lúc chạng vạng và ổ khóa nằm phía ngoài khiến Vinh nghi có người đã can thiệp vào căn phòng. Ban quản lý muốn mọi chuyện lắng xuống, còn vài món đồ công cộng biến mất khiến anh càng muốn tự tìm lời giải.",
     "appearance": "Gương mặt trái xoan, mũi thẳng, vóc người tầm thước ở tuổi ngoài ba mươi. Tóc đen cắt gọn, áo sơ mi xám nhạt bằng vải bông và đôi mắt sâu dưới hàng mày rậm.",
     "personality": "Lặng lẽ, thực tế và hơi đa nghi; Vinh quen quan sát trước khi lên tiếng. Anh ít tin vào tin đồn, nhưng một khi nhận ra chi tiết không hợp lý thì bám theo đến cùng.",
     "name": "Phạm Quang Vinh",
     "is_protagonist": true
    }
