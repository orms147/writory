   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Mai An",
      "personality": "Trầm lặng và kiên nhẫn, thường nghe hết lời người khác trước khi đáp. Dẫu sợ hãi, cô khó lòng bỏ qua một câu hỏi chưa có lời giải.",
      "backstory": "Mai An lớn lên ở làng Tro Sậy cùng câu chuyện cha mình mất tích trong một mùa nước lên. Từ ngày ấy, người làng chỉ nhắc đến ông bằng những câu nói lửng. Khi nhặt được dải vải mang tên cha bên cọc thề, cô buộc phải chọn giữa làm theo lời người giữ lễ và tự tìm hiểu điều đã bị chôn vùi.",
      "is_protagonist": true,
      "user_authored": true,
      "appearance": "Trông khoảng hai mươi lăm tuổi, người mảnh nhưng rắn rỏi, mặt trái xoan với tóc đen dài thường buộc thấp. Cô mặc áo nâu giản dị và váy tối màu, cổ tay quấn một sợi vải cũ đã sờn."
     }
    },
    {
     "id": "ba_lam",
     "label": "Character",
     "props": {
      "name": "Bà Lẫm",
      "aliases": [
       "người giữ lễ"
      ],
      "personality": "Cẩn trọng, quen giữ kín chuyện làng; khi bị dồn hỏi thường đáp bằng những câu ngắn.",
      "backstory": "Bà được chọn giữ lễ sau khi người giữ lễ trước mất trong một mùa nước dữ. Bà tin lời thề cũ đang giữ cho làng khỏi bị đầm nuốt.",
      "appearance": "Trông ngoài sáu mươi, người nhỏ và lưng hơi còng, mặt dài với tóc bạc búi thấp dưới khăn nâu. Bà mặc áo chàm sẫm, đeo một vòng đồng xỉn ở cổ tay trái."
     }
    },
    {
     "id": "le_van",
     "label": "Character",
     "props": {
      "name": "Lê Vân",
      "aliases": [
       "Vân"
      ],
      "personality": "Thẳng thắn, dễ nổi nóng khi thấy người khác bị ép im lặng, nhưng biết sợ những chuyện vượt khỏi lẽ thường.",
      "backstory": "Vân sống bằng nghề chài lưới và từng mất anh trai trong một đợt nước dâng bất thường. Cô vẫn giúp việc ở lễ buộc thề, dù không còn tin lời người lớn.",
      "appearance": "Trông khoảng ba mươi, vóc người rắn chắc, mặt vuông với tóc đen tết gọn sau gáy. Cô mặc áo vải sẫm xắn tay, đi chân đất và có vết sẹo nhỏ ngang cằm."
     }
    },
    {
     "id": "ong_huan",
     "label": "Character",
     "props": {
      "name": "Ông Huân",
      "aliases": [
       "Huân"
      ],
      "personality": "Ít nói, nhẫn nại, hay ngừng giữa câu như đang cân nhắc điều nên giữ lại.",
      "backstory": "Ông từng giúp người giữ lễ cũ ghi tên các nhà lên vải thề. Ông biết chuyện cha Mai An biến mất có liên quan đến nghi thức năm ấy, nhưng đã im lặng từ đó.",
      "appearance": "Trông gần bảy mươi, gầy và cao, gò má hõm, tóc bạc thưa chải ngược. Ông mặc áo nâu vá ở khuỷu tay, luôn cầm một cây gậy trúc có nút dây đỏ."
     }
    },
    {
     "id": "lang_tro_say",
     "label": "Location",
     "props": {
      "name": "Làng Tro Sậy",
      "description": "Ngôi làng dựng trên những doi đất thấp giữa đầm lầy, nơi dân làng truyền nhau lời thề cổ.",
      "visual": "Những mái nhà lá xám nép giữa lau cao và lối ván đen ẩm. Ánh sáng thường nhợt như bị sương nước giữ lại."
     }
    },
    {
