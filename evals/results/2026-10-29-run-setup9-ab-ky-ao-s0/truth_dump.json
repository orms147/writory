     "due_to_chapter": 5
    }
   },
   "nha_giu_le": {
    "label": "Location",
    "props": {
     "name": "Nhà Giữ Lễ",
     "visual": "Vách gỗ ám khói, mái lợp lá sẫm và cửa thấp chỉ vừa một người cúi đầu bước qua. Một ngọn đèn dầu vàng đục làm bóng đồ vật rung trên vách.",
     "description": "Căn nhà sàn nhỏ nơi cất vải thề và đồ dùng của nghi thức."
    }
   },
   "ong_huan": {
    "label": "Character",
    "props": {
     "backstory": "Ông từng giúp người giữ lễ cũ ghi tên các nhà lên vải thề. Ông biết chuyện cha Mai An biến mất có liên quan đến nghi thức năm ấy, nhưng đã im lặng từ đó.",
     "appearance": "Trông gần bảy mươi, gầy và cao, gò má hõm, tóc bạc thưa chải ngược. Ông mặc áo nâu vá ở khuỷu tay, luôn cầm một cây gậy trúc có nút dây đỏ.",
     "aliases": [
      "Huân"
     ],
     "personality": "Ít nói, nhẫn nại, hay ngừng giữa câu như đang cân nhắc điều nên giữ lại.",
     "name": "Ông Huân"
    }
   },
   "protagonist": {
    "label": "Character",
    "props": {
     "user_authored": true,
     "backstory": "Mai An lớn lên ở làng Tro Sậy cùng câu chuyện cha mình mất tích trong một mùa nước lên. Từ ngày ấy, người làng chỉ nhắc đến ông bằng những câu nói lửng. Khi nhặt được dải vải mang tên cha bên cọc thề, cô buộc phải chọn giữa làm theo lời người giữ lễ và tự tìm hiểu điều đã bị chôn vùi.",
     "appearance": "Trông khoảng hai mươi lăm tuổi, người mảnh nhưng rắn rỏi, mặt trái xoan với tóc đen dài thường buộc thấp. Cô mặc áo nâu giản dị và váy tối màu, cổ tay quấn một sợi vải cũ đã sờn.",
     "personality": "Trầm lặng và kiên nhẫn, thường nghe hết lời người khác trước khi đáp. Dẫu sợ hãi, cô khó lòng bỏ qua một câu hỏi chưa có lời giải.",
     "name": "Mai An",
     "is_protagonist": true
    }
   },
   "so_phan_coc_the": {
    "label": "Thread",
    "props": {
     "planted_chapter": 0,
     "description": "Cọc thề có được dựng lại trước khi nước tràn vào làng không?",
     "due_from_chapter": 2,
     "due_to_chapter": 7
    }
   },
   "so_phan_dai_vai": {
    "label": "Thread",
    "props": {
     "planted_chapter": 0,
     "description": "Mai An sẽ làm gì với dải vải mang tên cha?",
     "due_from_chapter": 1,
     "due_to_chapter": 7
    }
   },
   "ten_cha_con_tren_vai": {
    "label": "Fact",
    "props": {
     "text": "Tên cha Mai An vẫn được ghi trên dải vải tìm thấy bên cọc thề."
    }
   },
   "than_tro_minh": {
    "label": "Fact",
    "props": {
     "text": "Năm nay mặt đầm chuyển động bất thường như thể vị thủy thần bên dưới đang trở mình."
    }
   },
   "tieng_goi_tu_bai_lau": {
    "label": "Fact",
    "props": {
     "text": "Tiếng gọi khàn khàn vọng lên từ Bãi Lau Sâu trong đêm cọc thề bật khỏi đất."
    }
   }
