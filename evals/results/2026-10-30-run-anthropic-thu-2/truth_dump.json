   "danh_sach_diet": {
    "label": "Item",
    "props": {
     "aliases": [
      "danh sách đen"
     ],
     "name": "Danh sách cần diệt trừ",
     "description": "Mảnh giấy ghi tên những người bị coi là cần loại bỏ, được giấu kín trong tay áo của một khách dự tiệc."
    }
   },
   "doan_tu_man": {
    "label": "Character",
    "props": {
     "backstory": "Trưởng sứ của Huyền Thiên Các tại yến tiệc, người chủ trương loại bỏ những kẻ có thể cản trở việc tranh đoạt linh mạch.",
     "appearance": "Nữ tu khoảng ba mươi lăm tuổi, dáng cao ráo, môi tô son đỏ sẫm. Tóc xoăn dài buông một bên vai, khoác áo tím thẫm thêu chỉ bạc.",
     "aliases": [
      "Doãn cô nương"
     ],
     "personality": "Sắc sảo, lạnh lùng, thích nắm thóp người khác bằng lời lẽ mềm mỏng.",
     "name": "Doãn Tư Mẫn"
    }
   },
   "f_ban_do": {
    "label": "Fact",
    "props": {
     "text": "Hàn Vân Ngọc giữ một mảnh bản đồ chỉ đường tới linh mạch, do mẫu thân để lại."
    }
   },
   "f_danh_sach": {
    "label": "Fact",
    "props": {
     "text": "Doãn Tư Mẫn lập danh sách cần diệt trừ theo lệnh của Huyền Thiên Các."
    }
   },
   "f_khach_la": {
    "label": "Fact",
    "props": {
     "text": "Người lạ mặt tự xưng Ôn Tiên Sinh thật ra là Tống Minh Đình, chưởng môn Thanh Lam Phái, và ông chưa chết."
    }
   },
   "f_linh_mach": {
    "label": "Fact",
    "props": {
     "text": "Ba phái Thanh Lam, Huyền Thiên Các và Vạn Linh Môn đang tranh nhau một linh mạch ở Bạch Thủy Cốc."
    }
   },
   "f_luong_binh": {
    "label": "Fact",
    "props": {
     "text": "Lương Bình là tai mắt của Huyền Thiên Các trong phủ."
    }
   },
   "han_van_ngoc": {
    "label": "Character",
    "props": {
     "backstory": "Con trai thứ của một gia tộc tu tiên nhỏ ở Bạch Thủy Cốc, không được trọng vọng, được mời đến yến tiệc cầu hòa như một quân cờ để lấp chỗ trống.",
     "appearance": "Chàng trai hai mươi ba tuổi, gầy và xương xẩu, làn da xanh xao như ít thấy nắng. Tóc nâu hạt dẻ buộc hờ bằng dải lụa xanh lam.",
     "aliases": [
      "Hàn nhị công tử"
     ],
     "personality": "Ôn hòa bên ngoài nhưng cẩn trọng, ít nói, quen giấu cảm xúc trong con mắt dè chừng của gia tộc.",
     "name": "Hàn Vân Ngọc"
    }
   },
   "huyen_thien_cac": {
    "label": "Faction",
    "props": {
     "aliases": [
      "Huyền Các"
     ],
     "name": "Huyền Thiên Các",
     "description": "Thế lực tranh giành linh mạch, thường dùng mưu kế và ám tuyến để đạt mục đích."
    }
   },
   "lam_thuy_dinh": {
    "label": "Location",
    "props": {
     "aliases": [
      "đình bên hồ"
     ],
     "name": "Lâm Thủy Đình",
     "description": "Đình tiệc dựng bên mặt hồ trong phủ ở Bạch Thủy Cốc, nơi diễn ra yến tiệc cầu hòa.",
     "visual": "Ánh đèn lồng đỏ hắt lên mặt nước, cột gỗ lim đen bóng và rèm lụa mỏng bay theo gió. Không khí nồng mùi rượu và khói hương, đặc quánh sự dè chừng."
    }
   },
   "luong_binh": {
    "label": "Character",
    "props": {
     "backstory": "Người hầu trong phủ đã nhiều năm, nhưng thực chất là tai mắt của Huyền Thiên Các, luôn chờ lệnh để gieo nghi ngờ.",
     "appearance": "Người phụ nữ ngoài ba mươi, khuôn mặt tròn đầy, tóc hung đỏ cắt ngang vai. Mặc áo vải thô màu nâu đất, không trang sức.",
     "aliases": [
      "Bình bà"
     ],
     "personality": "Khéo léo, nhún nhường, nói nhỏ và nhìn người khác lâu hơn mức cần thiết.",
     "name": "Lương Bình"
    }
   },
   "protagonist": {
    "label": "Character",
    "props": {
     "user_authored": true,
     "backstory": "Nàng là đệ tử ngoại môn của Thanh Lam Phái, lớn lên trong cảnh tranh đoạt linh mạch giữa các môn phái. Sau biến cố ở Bạch Thủy Cốc, nàng bị điều đến hộ tống trong yến tiệc và được dặn không được rời mắt khỏi khách khứa. Nàng chưa biết mình đang canh giữ điều gì.",
     "appearance": "Thân hình thanh gọn, cao hơn đa số nữ tu cùng lứa, hai mươi hai tuổi. Khuôn mặt sắc cạnh với đôi mắt đen dài, tóc đen buộc cao bằng dải vải đỏ thẫm.",
     "personality": "Thẳng thắn, nóng tính, dễ mất kiên nhẫn khi bị vòng vo, nhưng rất trung thành với những người mình tin. Ánh mắt sắc và phản ứng nhanh khi có chuyện bất thường.",
     "name": "Cung Thiên Tịch",
     "is_protagonist": true
    }
   },
   "tay_vien": {
    "label": "Location",
    "props": {
     "aliases": [
      "viện phía tây"
     ],
     "name": "Tây Viện",
     "visual": "Lối đá xanh rêu, dây leo phủ kín tường rào thấp. Ban đêm chỉ có vài ngọn đèn đá lập lòe giữa sương.",
     "description": "Khu viện vắng ở phía tây phủ, nơi các khách không được phép đặt chân tới."
    }
   },
   "th_danh_sach": {
