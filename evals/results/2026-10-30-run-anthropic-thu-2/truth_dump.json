   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Cung Thiên Tịch",
      "personality": "Thẳng thắn, nóng tính, dễ mất kiên nhẫn khi bị vòng vo, nhưng rất trung thành với những người mình tin. Ánh mắt sắc và phản ứng nhanh khi có chuyện bất thường.",
      "backstory": "Nàng là đệ tử ngoại môn của Thanh Lam Phái, lớn lên trong cảnh tranh đoạt linh mạch giữa các môn phái. Sau biến cố ở Bạch Thủy Cốc, nàng bị điều đến hộ tống trong yến tiệc và được dặn không được rời mắt khỏi khách khứa. Nàng chưa biết mình đang canh giữ điều gì.",
      "is_protagonist": true,
      "user_authored": true,
      "appearance": "Thân hình thanh gọn, cao hơn đa số nữ tu cùng lứa, hai mươi hai tuổi. Khuôn mặt sắc cạnh với đôi mắt đen dài, tóc đen buộc cao bằng dải vải đỏ thẫm."
     }
    },
    {
     "id": "han_van_ngoc",
     "label": "Character",
     "props": {
      "name": "Hàn Vân Ngọc",
      "aliases": [
       "Hàn nhị công tử"
      ],
      "personality": "Ôn hòa bên ngoài nhưng cẩn trọng, ít nói, quen giấu cảm xúc trong con mắt dè chừng của gia tộc.",
      "backstory": "Con trai thứ của một gia tộc tu tiên nhỏ ở Bạch Thủy Cốc, không được trọng vọng, được mời đến yến tiệc cầu hòa như một quân cờ để lấp chỗ trống.",
      "appearance": "Chàng trai hai mươi ba tuổi, gầy và xương xẩu, làn da xanh xao như ít thấy nắng. Tóc nâu hạt dẻ buộc hờ bằng dải lụa xanh lam."
     }
    },
    {
     "id": "tong_minh_dinh",
     "label": "Character",
     "props": {
      "name": "Tống Minh Đình",
      "aliases": [
       "lạc khách",
       "Ôn Tiên Sinh"
      ],
      "personality": "Điềm đạm, nói năng vòng vèo và thích thử lòng người, nhưng quyết đoán khi đến lúc.",
      "backstory": "Từng là chưởng môn Thanh Lam Phái. Sau vụ ám sát giữa đường, người đời tin ông đã chết, còn ông lặng lẽ trở lại Bạch Thủy Cốc dưới một cái tên khác.",
      "appearance": "Người đàn ông ngoài bốn mươi, một vết sẹo dài chạy từ thái dương xuống má trái. Tóc bạc phơ búi bằng trâm gỗ mun, mặc áo xám tro không thêu hoa văn."
     }
    },
    {
     "id": "luong_binh",
     "label": "Character",
     "props": {
      "name": "Lương Bình",
      "aliases": [
       "Bình bà"
      ],
      "personality": "Khéo léo, nhún nhường, nói nhỏ và nhìn người khác lâu hơn mức cần thiết.",
      "backstory": "Người hầu trong phủ đã nhiều năm, nhưng thực chất là tai mắt của Huyền Thiên Các, luôn chờ lệnh để gieo nghi ngờ.",
      "appearance": "Người phụ nữ ngoài ba mươi, khuôn mặt tròn đầy, tóc hung đỏ cắt ngang vai. Mặc áo vải thô màu nâu đất, không trang sức."
     }
    },
    {
     "id": "doan_tu_man",
     "label": "Character",
     "props": {
