   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Lê Thị Mai",
      "personality": "Nhanh trí, kín đáo và nhạy với tâm trạng người khác. Mai thường dùng vẻ bông đùa để che sự bất an, nhưng không dễ bỏ qua những điều mình thấy bất thường.",
      "backstory": "Mai là nữ y tá trực tại một trạm y tế gần khu tập thể, sống cùng mẹ và em trong căn buồng nhỏ trên cùng tầng với ông Tấn. Cô thường thức khuya, nên biết tiếng bước chân và tiếng gõ vọng qua vách vào những đêm mùa đông, dù không chắc chúng bắt đầu từ căn hộ nào. Khi ông Tấn biến mất, những lần cô ra hành lang lấy nước khiến lời kể của cô được chú ý, đồng thời làm cô lo rằng hàng xóm sẽ xem mình là người xen vào chuyện riêng.",
      "is_protagonist": true,
      "user_authored": true
     }
    },
    {
     "id": "tran_tan",
     "label": "Character",
     "props": {
      "name": "Trần Tấn",
      "aliases": [
       "ông Tấn"
      ],
      "personality": "Ít lời, cẩn trọng, quen giữ việc riêng cho mình; khi bị dồn ép thường gõ nhịp đều lên mặt bàn.",
      "backstory": "Sống một mình trong căn buồng sát nhà Mai ở khu tập thể Khâm Thiên; trước khi mất tích, ông thường tranh cãi với người hàng xóm về một khoản tiền và những giấy tờ cũ."
     }
    },
    {
     "id": "pham_hoa",
     "label": "Character",
     "props": {
      "name": "Phạm Hòa",
      "aliases": [
       "chị Hòa"
      ],
      "personality": "Thực tế, dễ cáu khi bị hỏi dồn, nhưng vẫn để ý chuyện ăn ở của hàng xóm.",
      "backstory": "Ở buồng đối diện ông Tấn, làm công việc may gia công tại nhà và thường ra hành lang lấy nước vào ban đêm."
     }
    },
    {
     "id": "nguyen_binh",
