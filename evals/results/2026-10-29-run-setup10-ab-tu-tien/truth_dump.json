     ],
     "name": "Mảnh giấy mực ướt",
     "description": "Mảnh giấy ghi tên Tạ Vân Trạch bằng nét mực còn mới."
    }
   },
   "nguon_goc_linh_dien": {
    "label": "Thread",
    "props": {
     "planted_chapter": 0,
     "description": "Điều gì khiến sản lượng linh điền giảm?",
     "due_from_chapter": 2,
     "due_to_chapter": 4
    }
   },
   "pham_sua_so": {
    "label": "Fact",
    "props": {
     "text": "Phạm Văn Chiêu đã làm sai lệch số liệu sản lượng linh điền để che việc hắn chuyển một phần linh thảo khỏi kho của tông môn."
    }
   },
   "pham_van_chieu": {
    "label": "Character",
    "props": {
     "backstory": "Phạm Văn Chiêu quản lý sổ sách và nhân lực của Thanh Tùng Môn. Hắn được giao tiếp đón sứ giả của hai đại tông, trong khi những người trông coi linh điền lần lượt rời vị trí.",
     "appearance": "Khuôn mặt vuông, sống mũi gãy nhẹ và vóc người cao gầy khiến hắn trông ngoài bốn mươi tuổi. Mái tóc bạc cạo ngắn hai bên, áo bào nâu sẫm có cổ lót lông xám, ngón út bàn tay phải đeo một chiếc nhẫn ngọc đục.",
     "aliases": [
      "Chấp sự Phạm"
     ],
     "personality": "Nghiêm khắc, chuộng trật tự và ít khi bộc lộ ý định thật; hắn cho rằng một môn phái yếu phải biết nhượng bộ đúng lúc.",
     "name": "Phạm Văn Chiêu"
    }
   },
   "protagonist": {
    "label": "Character",
    "props": {
     "user_authored": true,
     "backstory": "Vân Trạch vào Thanh Tùng Môn với món nợ phải trả, còn việc làm ở dược viên là nguồn sống duy nhất của chàng. Gần đây, linh điền cho năng suất ngày một thấp, khiến những đệ tử cùng cảnh ngộ bắt đầu rời đi hoặc tìm đường nương nhờ nơi khác. Chàng lần vào hang đá để tìm hộp thuốc thất lạc, rồi gặp một đồng môn nằm bất động và mảnh giấy mang tên mình.",
     "appearance": "Vóc người cao vừa, vai rộng và khuôn mặt góc cạnh khiến chàng có vẻ ngoài khoảng hai mươi lăm tuổi. Mái tóc màu nâu sẫm buộc thấp sau gáy, áo vải xanh lục sờn ở khuỷu tay, một vết sẹo mảnh chạy ngang cằm.",
     "personality": "Gan góc, thực tế, đôi lúc buông lời đùa để che đi sự cảnh giác. Chàng dễ đứng về phía kẻ yếu thế, nhưng không muốn lòng tốt biến mình thành người bị lợi dụng.",
     "name": "Tạ Vân Trạch",
     "is_protagonist": true
    }
   },
   "san_luong_sut_giam": {
    "label": "Fact",
    "props": {
     "text": "Sản lượng linh thảo của dược viên đã giảm liên tiếp qua nhiều vụ."
    }
   },
   "so_bi_xe": {
    "label": "Fact",
    "props": {
     "text": "Một phần sổ ghi sản lượng linh điền đã bị xé khỏi cuốn sổ."
    }
   },
   "so_linh_dien": {
    "label": "Item",
    "props": {
     "aliases": [
      "sổ ghi chép"
     ],
     "name": "Sổ linh điền",
     "description": "Cuốn sổ ghi sản lượng linh điền qua từng vụ, có những trang bị xé khỏi gáy."
    }
   },
   "ten_tren_giay": {
    "label": "Fact",
    "props": {
     "text": "Mảnh giấy mực ướt trong hang đá ghi tên Tạ Vân Trạch."
    }
   },
   "thanh_tung_mon": {
    "label": "Faction",
    "props": {
     "name": "Thanh Tùng Môn",
     "description": "Tông môn nhỏ dựa vào dược viên và linh điền để nuôi sống đệ tử."
    }
   },
   "thu_kiem_ke": {
    "label": "Fact",
    "props": {
     "text": "Bạch Ngân Tông và Huyền Nhạc Tông đã gửi thư đòi kiểm kê linh điền của Thanh Tùng Môn."
    }
   },
   "tinh_coc": {
    "label": "Location",
    "props": {
     "name": "Tĩnh Cốc",
     "visual": "Sương trắng phủ lối đá xám, chỉ để lộ những vệt sáng lạnh giữa các vách núi ẩm. Không khí tĩnh lặng, thoảng mùi đất ướt và lá thuốc.",
     "description": "Khe núi hẹp bao quanh dược viên của Thanh Tùng Môn."
    }
   },
   "tinh_trang_tran_moc": {
    "label": "Thread",
    "props": {
     "planted_chapter": 0,
     "description": "Trần Mộc tỉnh lại hay không?",
     "due_from_chapter": 1,
     "due_to_chapter": 2
    }
   },
   "tran_moc": {
    "label": "Character",
    "props": {
     "backstory": "Trần Mộc là đệ tử ngoại môn làm việc ở dược viên. Cậu mất tích sau khi đi tìm một hộp thuốc thất lạc, và được tìm thấy bất động gần lối vào hang đá.",
     "appearance": "Đôi má bầu và vóc người thấp bé khiến cậu có vẻ ngoài chưa đầy hai mươi tuổi. Mái tóc vàng nâu xoăn lọn ngắn quanh tai, áo vải màu đất rộng ở vai, một bên tai có khuyên gỗ nhỏ.",
     "aliases": [
      "Mộc sư đệ"
     ],
     "personality": "Nhanh trí, nhút nhát trước quyền thế nhưng có lòng thương người; cậu thường giữ lại những điều nhỏ nhặt mà người khác cho là vô dụng.",
     "name": "Trần Mộc"
    }
   },
   "tran_moc_bat_tinh": {
    "label": "Fact",
    "props": {
     "text": "Trần Mộc đang nằm bất động gần lối vào hang đá."
    }
   }
