   },
   "duong_khac": {
    "label": "Character",
    "props": {
     "backstory": "Dương Khắc từng cùng các đệ tử ngoại môn trông coi dược viên. Gần đây hắn nhận việc vận chuyển hàng cho người ngoài tông, song chưa nói rõ điều kiện của chuyến hàng.",
     "appearance": "Vầng trán rộng và thân hình chắc nịch làm hắn có vẻ ngoài khoảng ba mươi tuổi. Tóc hoa râm cắt ngắn sát gáy, áo chàm dày viền da nâu, bên má trái có một nốt ruồi sẫm.",
     "aliases": [
