   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Tạ Vân Trạch",
      "personality": "Gan góc, thực tế, đôi lúc buông lời đùa để che đi sự cảnh giác. Chàng dễ đứng về phía kẻ yếu thế, nhưng không muốn lòng tốt biến mình thành người bị lợi dụng.",
      "backstory": "Vân Trạch vào Thanh Tùng Môn với món nợ phải trả, còn việc làm ở dược viên là nguồn sống duy nhất của chàng. Gần đây, linh điền cho năng suất ngày một thấp, khiến những đệ tử cùng cảnh ngộ bắt đầu rời đi hoặc tìm đường nương nhờ nơi khác. Chàng lần vào hang đá để tìm hộp thuốc thất lạc, rồi gặp một đồng môn nằm bất động và mảnh giấy mang tên mình.",
      "is_protagonist": true,
      "user_authored": true,
      "appearance": "Vóc người cao vừa, vai rộng và khuôn mặt góc cạnh khiến chàng có vẻ ngoài khoảng hai mươi lăm tuổi. Mái tóc màu nâu sẫm buộc thấp sau gáy, áo vải xanh lục sờn ở khuỷu tay, một vết sẹo mảnh chạy ngang cằm."
     }
    },
    {
     "id": "lam_tu_nguyet",
     "label": "Character",
     "props": {
      "name": "Lâm Tố Nguyệt",
      "aliases": [
       "Tố Nguyệt"
      ],
      "personality": "Điềm đạm, kín đáo và cẩn trọng trong từng lời nói; nàng muốn bảo vệ những người làm việc ở dược viên nhưng không dễ đặt niềm tin vào ai.",
      "backstory": "Lâm Tố Nguyệt từng phụ trách ghi chép sản lượng linh điền. Khi số liệu bắt đầu sai lệch, nàng bị điều sang công việc khác và giữ lại một bản ghi chưa giao nộp.",
      "appearance": "Gương mặt trái xoan, mắt dài và vóc người thanh mảnh khiến nàng có vẻ ngoài ngoài hai mươi tuổi. Mái tóc nâu đỏ tết thành một bím dài quá vai, dưới lớp áo vải màu xanh xám là chiếc trâm đồng hình lá."
     }
    },
    {
     "id": "duong_khac",
     "label": "Character",
     "props": {
      "name": "Dương Khắc",
      "aliases": [
       "Khắc sư huynh"
      ],
      "personality": "Thực dụng, nói năng mềm mỏng nhưng luôn cân nhắc lợi hại; hắn tin rằng sống sót qua biến động quan trọng hơn giữ lời hứa với một môn phái nhỏ.",
      "backstory": "Dương Khắc từng cùng các đệ tử ngoại môn trông coi dược viên. Gần đây hắn nhận việc vận chuyển hàng cho người ngoài tông, song chưa nói rõ điều kiện của chuyến hàng.",
      "appearance": "Vầng trán rộng và thân hình chắc nịch làm hắn có vẻ ngoài khoảng ba mươi tuổi. Tóc hoa râm cắt ngắn sát gáy, áo chàm dày viền da nâu, bên má trái có một nốt ruồi sẫm."
     }
    },
    {
     "id": "pham_van_chieu",
     "label": "Character",
     "props": {
      "name": "Phạm Văn Chiêu",
      "aliases": [
       "Chấp sự Phạm"
      ],
      "personality": "Nghiêm khắc, chuộng trật tự và ít khi bộc lộ ý định thật; hắn cho rằng một môn phái yếu phải biết nhượng bộ đúng lúc.",
      "backstory": "Phạm Văn Chiêu quản lý sổ sách và nhân lực của Thanh Tùng Môn. Hắn được giao tiếp đón sứ giả của hai đại tông, trong khi những người trông coi linh điền lần lượt rời vị trí.",
      "appearance": "Khuôn mặt vuông, sống mũi gãy nhẹ và vóc người cao gầy khiến hắn trông ngoài bốn mươi tuổi. Mái tóc bạc cạo ngắn hai bên, áo bào nâu sẫm có cổ lót lông xám, ngón út bàn tay phải đeo một chiếc nhẫn ngọc đục."
     }
