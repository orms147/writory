   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Trần Huyền Cơ",
      "personality": "Nóng nảy, bộc trực, giàu tình nghĩa. Hắn không thích âm mưu, thà đấu kiếm hơn đấu miệng.",
      "backstory": "Con nuôi của tông chủ tiền nhiệm, sau khi tông chủ mất, hắn giữ Tông Chủ ấn. Các trưởng lão nghi ngờ hắn có mưu đồ và vu cho hắn âm mưu hợp tác với Ma Môn để tiêu diệt tông môn.",
      "is_protagonist": true,
      "user_authored": true
     }
    },
    {
     "id": "luc_thanh_phong",
     "label": "Character",
     "props": {
      "name": "Lục Thanh Phong",
      "aliases": [
       "Lục trưởng lão"
      ],
      "personality": "Giảo hoạt, thâm trầm, luôn giữ thái độ điềm tĩnh. Là người có dã tâm lớn và không từ thủ đoạn.",
      "backstory": "Trưởng lão thủ tịch của Vạn Đạo Tông, từng là đại đệ tử của tông chủ tiền nhiệm, luôn khao khát ngôi vị tông chủ. Sau khi tông chủ mất, hắn mưu tính kết hợp với Ma Môn để hạ bệ Trần Huyền Cơ."
     }
    },
    {
     "id": "trieu_van_son",
     "label": "Character",
     "props": {
      "name": "Triệu Vân Sơn",
      "aliases": [
       "Triệu trưởng lão"
      ],
      "personality": "Bảo thủ, trung thành với tông môn nhưng dễ bị lung lay bởi lợi ích. Không thích âm mưu nhưng lại bị cuốn vào.",
      "backstory": "Trưởng lão kỳ cựu, phụ trách tài vụ của tông. Ban đầu tin vào lời Lục Thanh Phong rằng Trần Huyền Cơ có tội, nhưng trong lòng còn nhiều nghi vấn."
     }
    },
    {
     "id": "vuong_tuyet_nghi",
     "label": "Character",
     "props": {
      "name": "Vương Tuyết Nghi",
      "aliases": [
       "Vương trưởng lão"
      ],
      "personality": "Trầm tĩnh, sắc sảo, nhạy bén với mưu đồ. Trong lòng vẫn tin vào Trần Huyền Cơ nhưng phải giữ thể diện tông môn.",
      "backstory": "Nữ trưởng lão duy nhất, từng là đệ tử thân tín của cố tông chủ. Biết nhiều bí mật về cái chết của tông chủ và đang lặng lẽ điều tra."
     }
    },
    {
     "id": "van_dao_dien",
     "label": "Location",
     "props": {
      "name": "Vạn Đạo Điện",
      "aliases": [
       "Đại điện"
      ],
      "description": "Phủ chủ điện của Vạn Đạo Tông, rộng lớn và lạnh lẽo, chỉ có vài ngọn đèn dầu leo lét."
     }
    },
    {
