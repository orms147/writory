   "ong_ba": {
    "label": "Character",
    "props": {
     "backstory": "Ông từng cùng dân làng đóng cọc ngăn nước ở bờ xóm, và nhớ phần lời thề liên quan đến việc không rút cọc khỏi đầm.",
