     "name": "Ông Bá"
    }
   },
   "protagonist": {
    "label": "Character",
    "props": {
     "user_authored": true,
     "backstory": "Lâm lớn lên ở xóm Chìm, phụ người nhà vá sàn và đưa đò qua những lối nước quanh xóm. Cậu từng nghe người gác đầm kể vài đoạn về lời thề, nhưng chưa bao giờ nghĩ chúng sẽ liên quan đến mình. Sáng nay, ông nắm lấy tay cậu bên chiếc cọc bật khỏi bùn và để lại lời nhắn đứt quãng.",
     "personality": "Kiệm lời, bền bỉ và quen quan sát trước khi hành động. Khi người khác tranh cãi, cậu thường tìm cách nghe hết mọi phía.",
     "name": "Nguyễn Lâm",
     "is_protagonist": true
    }
   },
