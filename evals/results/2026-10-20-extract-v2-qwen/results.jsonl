": null, "id": "REVEALED_TO_PLAYER:gu>ch1@1", "props": {"quote": "Tên thật của lão là Hồ Sĩ Bằng, nhưng cả phố chỉ gọi lão là Lão Gù", "known_as": "Lão Gù"}}, {"type": "LOCATED_AT", "from": "gu", "to": "lo_ren", "valid_from_chapter": 1, "valid_to_chapter": null, "id": "LOCATED_AT:gu>lo_ren@1", "props": {}}, {"type": "HOLDS", "from": "gu", "to": "sword", "valid_from_chapter": 1, "valid_to_chapter": null, "id": "HOLDS:gu>sword@1", "props": {}}, {"type": "REVEALED_TO_PLAYER", "from": "sword", "to": "ch1", "valid_from_chapter": 1, "valid_to_chapter": null, "id": "REVEALED_TO_PLAYER:sword>ch1@1", "props": {"quote": "— Thanh Sương, — lão nói, không ngẩng lên. — Ba mươi năm rồi ta mới rút nó ra khỏi vỏ.", "known_as": "Thanh Sương"}}, {"type": "RELATES_TO", "from": "minh", "to": "gu", "valid_from_chapter": 1, "valid_to_chapter": null, "id": "RELATES_TO:minh>gu@1", "props": {"kind": "thầy trò", "score": 50}}, {"type": "KNOWS", "from": "minh", "to": "f_lan_spy", "valid_from_chapter": 1, "valid_to_chapter": null, "id": "KNOWS:minh>f_lan_spy@1", "props": {"how": "suy ra", "quote": "Minh hỏi lão sợ ai, lão chỉ phẩy tay đuổi về.\n\nRa khỏi lò rèn, Minh gặp cai Trần Văn Khải đang đi tuần với hai tên lính. Khải cùng họ Trần với Minh nhưng chẳng họ hàng gì, vậy mà lần nào gặp hắn cũng gọi Minh là \"chú em họ\" cho lính cười. Hôm nay hắn không đùa. Hắn hỏi Minh có thấy thuyền lạ nào cập bến đêm qua không. Minh bảo không. Khải gật đầu, nhìn về phía quán trà một lúc, rồi đi tiếp.\n\nTối đó Minh nằm nghe sông chảy, nghĩ mãi về câu dặn của Lão Gù, và về nụ cười của cô bán trà."}}, {"type": "REVEALED_TO_PLAYER", "from": "khai", "to": "ch1", "valid_from_chapter": 1, "valid_to_chapter": null, "id": "REVEALED_TO_PLAYER:khai>ch1@1", "props": {"quote": "Minh gặp cai Trần Văn Khải đang đi tuần với hai tên lính.", "known_as": "cai Trần Văn Khải"}}, {"type": "RELATES_TO", "from": "minh", "to": "khai", "valid_from_chapter": 1, "valid_to_chapter": null, "id": "RELATES_TO:minh>khai@1", "props": {"ki