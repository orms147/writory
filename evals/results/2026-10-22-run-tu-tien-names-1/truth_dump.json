    "summary": null,
    "outlines": [
     {
      "scene": 1,
      "goal": "Đỗ Minh Viễn tìm cách xoay xở giữa hai toán tu sĩ đang phong tỏa bến, đồng thời dò xem có thể gom lương và tiếp cận lối thoát nào mà chưa phải chọn phe.",
      "present": [
       "protagonist",
       "doan_thanh_lien",
       "phung_khai"
      ],
      "beats": [
       "Trong khoang Thuyền Tích Lương, Đỗ Minh Viễn nghe tiếng quát tháo vọng từ bến và nhìn thấy bóng tu sĩ canh các lối ra; chàng hiểu rằng rời thuyền lúc này chỉ khiến mình bị giữ lại để tra hỏi.",
       "Đoàn Thanh Liên ghé tới, hạ giọng bảo rằng cả Thanh Huyền Môn lẫn Xích Vân Tông đều đang truy tìm người đã lên thuyền đêm qua; nàng khuyên Minh Viễn đừng tùy tiện khai một cái tên khi chưa biết phe nào sẽ giữ lời.",
       "Minh Viễn hỏi Phùng Khải về lương khô cho chuyến vượt sông ngắn; lão Phùng không trao túi lương, chỉ đáp rằng thứ gì cũng có giá, rồi dò xem chàng định dựa vào phe nào để ra khỏi Hàn Sa.",
       "Chàng lựa lời tránh hứa hẹn, hỏi Đoàn Thanh Liên liệu còn đường nào qua vùng sương mà không phải đi qua các toán canh; nàng chỉ nói lối vào sương khó đoán, rồi ngừng lời khi nghe tiếng chân tuần tra áp sát.",
       "Khi tiếng chân rời xa, Minh Viễn quyết định chưa khai tên ai và chưa nhận lời theo phe nào; chàng kín đáo nhờ Đoàn Thanh Liên chỉ cho mình hướng tới Lối Vào Sương, đổi lại sẽ cùng nàng tìm cách thoát khỏi cuộc tra hỏi trước mắt."
      ],
      "ends_at": "Cảnh kết trên Thuyền Tích Lương, khi Đỗ Minh Viễn và Đoàn Thanh Liên chuẩn bị rời thuyền để dò đường về phía Lối Vào Sương.",
      "resolves": [],
      "unplanned_threads": []
     }
