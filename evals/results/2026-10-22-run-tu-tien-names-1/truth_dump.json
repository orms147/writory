    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Đỗ Minh Viễn",
      "personality": "Khéo ăn nói, biết đọc sắc mặt và thường tìm cách giữ lại đường lui cho mình. Chàng có vẻ dễ thỏa hiệp, nhưng không chịu để kẻ khác quyết định thay vận mệnh của mình.",
      "backstory": "Đỗ Minh Viễn từng theo một đoàn áp tải lương thực, rồi bỏ việc sau khi đoàn tan tác vì tranh chấp giữa các tông môn. Tại Hàn Sa, chàng nhận việc trên thuyền để kiếm đủ tiền rời khỏi vùng sông mù. Vụ án mạng khiến chàng mắc kẹt giữa hai phe, còn những người từng làm thuê cùng chàng có thể đang tìm cách đổi chác một lối thoát.",
      "is_protagonist": true,
      "user_authored": true
     }
    },
    {
     "id": "lam_tu_khoi",
     "label": "Character",
     "props": {
      "name": "Lâm Tử Khôi",
      "aliases": [
       "chủ thuyền"
      ],
      "personality": "Cẩn trọng, thực dụng, ít lời; quen giữ nhiều đường lui và không tin lời hứa nếu chưa thấy cái giá.",
      "backstory": "Chủ con thuyền chở lương nơi Đỗ Minh Viễn làm thuê. Trước khi bị sát hại, ông ta đã âm thầm thương lượng với các tông môn về quyền qua bến."
     }
    },
    {
     "id": "tran_mac",
     "label": "Character",
     "props": {
      "name": "Trần Mặc",
      "aliases": [
       "Trần đạo trưởng"
      ],
      "personality": "Điềm tĩnh, sắc sảo, thường dùng câu hỏi thay cho đe dọa; coi người và vật đều là quân cờ nếu cần.",
      "backstory": "Tu sĩ của Thanh Huyền Môn, được phái đến Hàn Sa để giành quyền kiểm soát bến và truy tìm thẻ bài thất lạc."
     }
    },
    {
     "id": "doan_thanh_lien",
     "label": "Character",
     "props": {
      "name": "Đoàn Thanh Liên",
      "aliases": [
       "Đoàn cô nương"
      ],
      "personality": "Gan lì, kín tiếng, luôn tính trước một bước; không dễ tin ai, nhưng đã nhận lời thì khó đổi ý.",
      "backstory": "Tu sĩ của Xích Vân Tông, từng cùng đoàn áp tải lương với Đỗ Minh Viễn trước khi đoàn tan tác."
     }
    },
    {
