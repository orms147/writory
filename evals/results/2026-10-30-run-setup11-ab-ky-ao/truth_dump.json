   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Nguyễn An",
      "personality": "Điềm đạm, kiên nhẫn và thường nghe hết lời người khác trước khi đáp. Khi đã nhận trách nhiệm, An khó lòng bỏ dở dù lòng còn nhiều ngờ vực.",
      "backstory": "An lớn lên trong một gia đình đặt lờ ở Rạch Mù, quen nhìn con nước đổi màu qua từng mùa. Sau đêm nước tràn qua sân, An được giao mang chiếc trống thất lạc về miếu trước buổi họp làng. Tiếng gọi vọng lên từ những vũng nước nông khiến chuyến đi ấy trở nên khó phớt lờ.",
      "is_protagonist": true,
      "user_authored": true,
      "appearance": "Gương mặt trái xoan, vóc người thanh mảnh, khoảng hai mươi tuổi. Mái tóc nâu sẫm dài quá vai, buộc thấp bằng sợi vải xám; An mặc áo vải màu đất và có nốt ruồi nhỏ sát cằm."
     }
    },
    {
     "id": "ba_lien",
     "label": "Character",
     "props": {
      "name": "Bà Liên",
      "aliases": [
       "bà từ"
      ],
      "personality": "Cứng rắn, coi trọng lời hứa và sự yên ổn của làng; khi bất đồng, bà thường nói thẳng điều mình lo sợ.",
      "backstory": "Bà Liên trông nom miếu từ khi người giữ miếu trước qua đời. Bà từng chứng kiến một mùa nước dâng khiến nhiều nhà phải bỏ đi, nên không muốn dân làng xem nhẹ lời thề.",
      "appearance": "Gương mặt vuông với nếp nhăn sâu, vóc người thấp đậm, khoảng ngoài sáu mươi tuổi. Tóc bạc cuộn gọn sau gáy, bà mặc áo nâu sẫm bằng vải thô và đeo một chiếc vòng đồng cũ."
     }
    },
    {
     "id": "le_vinh",
     "label": "Character",
     "props": {
      "name": "Lê Vĩnh",
      "aliases": [
       "ông Vĩnh"
      ],
      "personality": "Thực tế, ít kiên nhẫn với chuyện không thể kiểm chứng, nhưng không muốn người trong làng bị bỏ mặc.",
      "backstory": "Lê Vĩnh từng dẫn nhiều chuyến đổi cá lấy gạo qua các lạch quanh đầm. Khi bến cạn dần, ông thay mặt một số hộ đặt lờ lên tiếng đòi sửa lại cách giữ lời thề.",
      "appearance": "Gương mặt dài, hàm nhọn và vóc người gầy cao, trạc năm mươi tuổi. Tóc hoa râm cắt sát hai bên, ông mặc áo chàm bạc màu và có một vết sẹo mảnh ngang lông mày trái."
     }
    },
    {
     "id": "doan_mai",
     "label": "Character",
     "props": {
      "name": "Đoàn Mai",
      "aliases": [
       "Mai"
      ],
      "personality": "Tò mò, nhanh trí và hay hỏi đến cùng khi một lời giải thích có chỗ chưa khớp.",
      "backstory": "Đoàn Mai sống cùng mẹ gần rìa đầm và thường phụ người lớn kiểm tra lờ. Cô biết những lối đi giữa lau sậy, kể cả vài lối đã bị nước lấp.",
      "appearance": "Đôi mắt tròn trên gương mặt trái xoan, vóc người nhỏ nhắn, khoảng mười bảy tuổi. Mái tóc nâu đỏ xoăn ngắn chạm cằm, cô mặc áo xanh rêu bằng vải dệt thô và đeo khuyên bạc nhỏ ở tai phải."
     }
    },
