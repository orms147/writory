  "nodes": {
   "ba_lien": {
    "label": "Character",
    "props": {
     "backstory": "Bà Liên trông nom miếu từ khi người giữ miếu trước qua đời. Bà từng chứng kiến một mùa nước dâng khiến nhiều nhà phải bỏ đi, nên không muốn dân làng xem nhẹ lời thề.",
     "appearance": "Gương mặt vuông với nếp nhăn sâu, vóc người thấp đậm, khoảng ngoài sáu mươi tuổi. Tóc bạc cuộn gọn sau gáy, bà mặc áo nâu sẫm bằng vải thô và đeo một chiếc vòng đồng cũ.",
     "aliases": [
      "bà từ"
     ],
     "personality": "Cứng rắn, coi trọng lời hứa và sự yên ổn của làng; khi bất đồng, bà thường nói thẳng điều mình lo sợ.",
     "name": "Bà Liên"
    }
   },
   "ben_can": {
    "label": "Location",
    "props": {
     "aliases": [
      "bến làng"
     ],
     "name": "Bến Cạn",
     "visual": "Bậc gỗ xám lộ ra trên lớp bùn nứt, vài vũng nước đọng phản chiếu một khoảng trời trắng đục. Lau khô rạp xuống trong gió lạnh.",
     "description": "Bến đất cũ nơi dân làng thường đưa cá lên bờ."
    }
   },
   "ben_cang_can": {
    "label": "Fact",
    "props": {
     "text": "Bến Cạn đã lộ bùn nứt qua nhiều mùa nước."
    }
   },
   "ch0": {
    "label": "Chapter",
    "props": {
     "number": 0
    }
   },
   "dan_rach_mu": {
    "label": "Faction",
    "props": {
     "aliases": [
      "dân làng"
     ],
     "name": "Dân Rạch Mù",
     "description": "Những hộ trong làng dựa vào nghề đặt lờ và cùng gìn giữ lời thề với vị thủy thần."
    }
   },
   "doan_mai": {
    "label": "Character",
    "props": {
     "backstory": "Đoàn Mai sống cùng mẹ gần rìa đầm và thường phụ người lớn kiểm tra lờ. Cô biết những lối đi giữa lau sậy, kể cả vài lối đã bị nước lấp.",
     "appearance": "Đôi mắt tròn trên gương mặt trái xoan, vóc người nhỏ nhắn, khoảng mười bảy tuổi. Mái tóc nâu đỏ xoăn ngắn chạm cằm, cô mặc áo xanh rêu bằng vải dệt thô và đeo khuyên bạc nhỏ ở tai phải.",
     "aliases": [
      "Mai"
     ],
     "personality": "Tò mò, nhanh trí và hay hỏi đến cùng khi một lời giải thích có chỗ chưa khớp.",
     "name": "Đoàn Mai"
    }
   },
   "hoi_giu_mieu": {
    "label": "Faction",
    "props": {
     "aliases": [
      "người giữ miếu"
     ],
     "name": "Hội Giữ Miếu",
     "description": "Nhóm người thay phiên trông coi miếu và gìn giữ những vật dùng trong lễ thề."
    }
   },
   "le_vinh": {
    "label": "Character",
    "props": {
     "backstory": "Lê Vĩnh từng dẫn nhiều chuyến đổi cá lấy gạo qua các lạch quanh đầm. Khi bến cạn dần, ông thay mặt một số hộ đặt lờ lên tiếng đòi sửa lại cách giữ lời thề.",
     "appearance": "Gương mặt dài, hàm nhọn và vóc người gầy cao, trạc năm mươi tuổi. Tóc hoa râm cắt sát hai bên, ông mặc áo chàm bạc màu và có một vết sẹo mảnh ngang lông mày trái.",
     "aliases": [
      "ông Vĩnh"
     ],
     "personality": "Thực tế, ít kiên nhẫn với chuyện không thể kiểm chứng, nhưng không muốn người trong làng bị bỏ mặc.",
     "name": "Lê Vĩnh"
    }
   },
   "loi_goi_tu_vung": {
    "label": "Thread",
    "props": {
     "planted_chapter": 0,
     "description": "Điều gì gây ra tiếng gọi vọng lên từ những vũng nước nông?",
     "due_from_chapter": 3,
     "due_to_chapter": 5
    }
   },
   "loi_lau": {
    "label": "Location",
    "props": {
     "aliases": [
      "đường qua lau"
     ],
     "name": "Lối Lau",
     "visual": "Lau cao che khuất hai bên lối đi, thân cây quệt vào nhau thành tiếng khô khốc. Nước nông nằm rải rác trên nền đất tối.",
     "description": "Lối đất hẹp nối làng với miếu, men qua những vạt lau sát đầm."
    }
   },
   "loi_the_co": {
    "label": "Fact",
    "props": {
     "text": "Dân Rạch Mù có lệ đánh trống tại miếu để nhắc lại lời thề với vị thủy thần đang ngủ dưới đầm."
    }
