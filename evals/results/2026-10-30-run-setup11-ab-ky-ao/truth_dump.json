    "label": "Fact",
    "props": {
     "text": "Đêm trước khi câu chuyện bắt đầu, nước đầm tràn qua một số sân nhà ở Rạch Mù."
    }
   },
   "protagonist": {
    "label": "Character",
    "props": {
     "user_authored": true,
     "backstory": "An lớn lên trong một gia đình đặt lờ ở Rạch Mù, quen nhìn con nước đổi màu qua từng mùa. Sau đêm nước tràn qua sân, An được giao mang chiếc trống thất lạc về miếu trước buổi họp làng. Tiếng gọi vọng lên từ những vũng nước nông khiến chuyến đi ấy trở nên khó phớt lờ.",
     "appearance": "Gương mặt trái xoan, vóc người thanh mảnh, khoảng hai mươi tuổi. Mái tóc nâu sẫm dài quá vai, buộc thấp bằng sợi vải xám; An mặc áo vải màu đất và có nốt ruồi nhỏ sát cằm.",
     "personality": "Điềm đạm, kiên nhẫn và thường nghe hết lời người khác trước khi đáp. Khi đã nhận trách nhiệm, An khó lòng bỏ dở dù lòng còn nhiều ngờ vực.",
     "name": "Nguyễn An",
     "is_protagonist": true
    }
   },
