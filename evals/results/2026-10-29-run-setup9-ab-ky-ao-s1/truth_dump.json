    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Lê Quốc Duy",
      "personality": "Nhạy cảm, kiên nhẫn và có trí nhớ tốt về âm thanh, lời kể. Duy dễ bị nỗi sợ lấn át, nhưng vẫn bước tới khi tin rằng có người đang cần mình.",
      "backstory": "Duy phụ cha sửa mái chèo và thường ngồi ở bến nghe những người chèo đò kể về lời thề cổ. Gần đây, cậu liên tục nghe tiếng gõ vọng lên từ mặt nước, dù quanh đó không có ai. Khi đứa trẻ lạ trao chiếc chuông đồng cho người gác bến, Duy nhận ra nhịp gõ ấy giống hệt âm thanh mình đã nghe và quyết tìm hiểu chuyện gì đang xảy ra.",
      "is_protagonist": true,
      "user_authored": true,
      "appearance": "Trông khoảng hai mươi tuổi, dáng người gọn và hơi khom vì quen cúi sửa mái chèo, mặt dài, tóc đen cắt gọn. Duy mặc áo vải nâu sẫm, cổ tay áo sờn; một vết chai nhỏ nằm ngang lòng bàn tay phải."
     }
    },
    {
     "id": "le_thi_hanh",
     "label": "Character",
     "props": {
      "name": "Lê Thị Hạnh",
      "aliases": [
       "bà Hạnh"
      ],
      "personality": "Cẩn trọng, cứng rắn, thương người nhưng sợ lời thề bị phá.",
      "backstory": "Bà là người trông coi nhà thờ lời thề của Cồn Mù, được dân làng giao giữ chiếc chuông đồng qua nhiều năm. Đêm trước, bà đem chuông ra bến để kiểm tra sau khi nghe tiếng gõ dưới nước, rồi bị một đứa trẻ lạ lấy mất.",
      "appearance": "Trông ngoài sáu mươi, dáng nhỏ và hơi còng, mặt nhiều nếp nhăn, tóc bạc búi thấp dưới khăn nâu. Bà mặc áo chàm sẫm, đeo một vòng chìa khóa ở thắt lưng."
     }
    },
    {
     "id": "pham_van_khoi",
     "label": "Character",
     "props": {
      "name": "Phạm Văn Khôi",
      "aliases": [
       "ông Khôi"
      ],
      "personality": "Ít lời, thực tế, quyết đoán khi có nguy hiểm.",
      "backstory": "Ông là người chèo đò lâu năm ở Cồn Mù và từng học thuộc lời thề từ cha mình. Ông cho rằng không ai nên rời bến trong đêm nước dâng.",
      "appearance": "Trông ngoài năm mươi, vai rộng, mặt vuông rám nắng, tóc đen lẫn bạc cắt ngắn. Ông mặc áo tơi sẫm và luôn chống một cây sào tre có đầu quấn dây đỏ."
     }
    },
    {
     "id": "tran_min",
     "label": "Character",
     "props": {
      "name": "Trần Minh",
      "aliases": [
       "đứa trẻ lạ"
      ],
      "personality": "Trầm lặng, dè dặt, có vẻ như đang cố cảnh báo người khác.",
      "backstory": "Minh xuất hiện trên mặt đầm trong đêm nước dâng, trao chiếc chuông đồng cho người gác bến rồi biến vào sương. Cậu bé là đứa con đã mất của một gia đình chèo đò, nhưng không ai trong làng biết vì sao hình bóng cậu trở lại.",
      "appearance": "Trông khoảng mười tuổi, người gầy nhỏ, mặt tái nhợt, tóc đen ướt bết vào trán. Cậu mặc áo vải xám cũ, chân trần và có một sợi dây xanh buộc ở cổ tay trái."
