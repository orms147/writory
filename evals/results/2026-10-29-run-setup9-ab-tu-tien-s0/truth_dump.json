   "ta_minh_vien": {
    "label": "Character",
    "props": {
     "backstory": "Từng cùng Tạ Duy Khiêm làm việc ở ruộng thuốc. Anh mất tích sau khi phát hiện sổ kiểm kê linh thảo có chỗ bị sửa đổi.",
     "appearance": "Trông khoảng hai mươi lăm tuổi, người cao gầy, mặt dài và tóc đen buộc gọn sau gáy; thường mặc áo môn sinh màu tro đã sờn, bên hông có một vết sẹo mảnh sát cổ tay.",
     "aliases": [
