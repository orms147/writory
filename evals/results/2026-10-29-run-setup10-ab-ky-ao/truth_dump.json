     "name": "Chiếc đèn cũ",
     "description": "Chiếc đèn dầu móp một góc, còn vệt muội đen quanh chụp đồng."
    }
   },
   "doan_nhu": {
    "label": "Character",
    "props": {
     "backstory": "Như chăm nom miếu nước ở rìa làng và thuộc những bài khấn truyền qua nhiều đời. Bà đã nghe tiếng nước đổi nhịp dưới đầm từ trước khi người gác đêm qua đời.",
     "appearance": "Gò má cao, dáng người thanh mảnh và tuổi gần bốn mươi. Mái tóc nâu sẫm xoăn nhẹ chạm vai, áo xanh rêu viền chỉ bạc, một vòng hạt gỗ sáng màu quấn hai lượt quanh cổ tay.",
     "aliases": [
      "Như thầy cúng"
     ],
     "personality": "Bình tĩnh, giàu lòng thương, tin vào nghi thức nhưng không tin rằng mọi điều xưa cũ đều phải được giữ nguyên.",
     "name": "Đoàn Như"
    }
   },
   "fact_1": {
    "label": "Fact",
    "props": {
     "text": "Người gác đêm thay phiên đọc lời thề cổ tại trạm canh Cồn Lặng."
    }
   },
   "fact_2": {
    "label": "Fact",
    "props": {
     "text": "Dân Xóm Bàng tin rằng lời thề cổ giữ vị thủy thần đang ngủ dưới đầm."
    }
   },
   "fact_3": {
    "label": "Fact",
    "props": {
     "text": "Người gác đêm vừa qua đời là ông Phúc."
    }
   },
   "fact_4": {
    "label": "Fact",
    "props": {
     "text": "Bà Lành nhận ra nét chữ trên lời nhắn là nét chữ của ông Phúc."
