 "packages": {
  "0": {
   "commit_id": "run-20261029-setup10-ab-ky-ao-45864115-ch0",
   "nodes": [
    {
     "id": "protagonist",
     "label": "Character",
     "props": {
      "name": "Lê Minh Tâm",
      "personality": "Điềm đạm, hay lắng nghe hơn tranh cãi. Khi đã nhận lời, anh khó lòng quay lưng dù biết mình có thể gặp nguy hiểm.",
      "backstory": "Tâm từng phụ cha chèo thuyền qua những bến lau quanh Cồn Lặng. Sau khi cha mất trong một đêm sương dày, anh rời làng và tránh nhắc đến trạm canh. Nay được gọi về nhận ca trực kế tiếp, anh thấy chiếc đèn cũ trên mũi thuyền và quyết tìm người nhận ra nét chữ trong lời nhắn.",
      "is_protagonist": true,
      "user_authored": true,
      "appearance": "Gương mặt trái xoan, vóc người gọn và tuổi ngoài hai mươi. Tóc nâu hạt dẻ dài vừa, buộc thấp sau gáy; áo chàm xanh sẫm bằng vải dày, bên tai trái có nốt ruồi nhỏ."
     }
    },
    {
     "id": "ba_lam",
     "label": "Character",
     "props": {
      "name": "Bà Lành",
      "aliases": [
       "Bà giữ sổ"
      ],
      "personality": "Kín đáo, cứng cỏi, nói năng dè sẻn; không dễ tin người nhưng luôn giữ lời đã hứa.",
      "backstory": "Bà từng chép lời thề của các làng ven đầm vào sổ trạm canh. Sau cái chết của người gác đêm trước, bà giữ im lặng về những nét chữ mình nhận ra.",
      "appearance": "Khuôn mặt dài với đôi mắt sâu, dáng người nhỏ và tuổi ngoài sáu mươi. Mái tóc bạc tết gọn sau gáy, áo chàm sẫm bằng vải thô, một chiếc trâm đồng hình lá lau cài bên thái dương."
     }
    },
    {
     "id": "vu_dat",
     "label": "Character",
     "props": {
      "name": "Vũ Đạt",
      "aliases": [
       "Đạt chèo"
      ],
      "personality": "Nóng ruột, thực tế, ghét những lời úp mở; vẫn thương người làng và sợ đầm sâu hơn những gì anh thừa nhận.",
      "backstory": "Đạt lớn lên ở xóm bến, làm nghề đưa đò giữa các bãi lau. Anh là người cuối cùng nhìn thấy người gác đêm còn sống trước khi chiếc thuyền trống cập trạm.",
      "appearance": "Gương mặt vuông, thân hình rộng vai và tuổi chừng ba mươi. Tóc nâu đỏ cắt ngắn, áo nâu đất dệt thô khoác ngoài áo vải xám, một vết sẹo mảnh chạy ngang cằm."
     }
    },
    {
     "id": "doan_nhu",
     "label": "Character",
     "props": {
      "name": "Đoàn Như",
      "aliases": [
       "Như thầy cúng"
      ],
      "personality": "Bình tĩnh, giàu lòng thương, tin vào nghi thức nhưng không tin rằng mọi điều xưa cũ đều phải được giữ nguyên.",
      "backstory": "Như chăm nom miếu nước ở rìa làng và thuộc những bài khấn truyền qua nhiều đời. Bà đã nghe tiếng nước đổi nhịp dưới đầm từ trước khi người gác đêm qua đời.",
      "appearance": "Gò má cao, dáng người thanh mảnh và tuổi gần bốn mươi. Mái tóc nâu sẫm xoăn nhẹ chạm vai, áo xanh rêu viền chỉ bạc, một vòng hạt gỗ sáng màu quấn hai lượt quanh cổ tay."
     }
    },
    {
     "id": "tram_can_con_lang",
     "label": "Location",
     "props": {
      "name": "Trạm canh Cồn Lặng",
      "aliases": [
       "Trạm canh"
      ],
      "description": "Trạm canh tách khỏi làng, nơi người gác đêm thay nhau đọc lời thề cổ bên mép đầm.",
      "visual": "Ánh đèn vàng yếu lọt qua vách nứa và mái tranh ẩm. Sàn gỗ sẫm nổi trên những cọc đóng giữa lau, trong không khí phảng phất mùi bùn lạnh."
     }
    },
    {
     "id": "ben_lau_vet",
     "label": "Location",
     "props": {
      "name": "Bến Lau Vẹt",
      "aliases": [
       "Bến lau"
      ],
      "description": "Bến nước khuất sau một dải lau rậm, nơi chiếc thuyền không người mắc cạn.",
      "visual": "Sương trắng đục phủ ngang mặt nước, chỉ để lộ những cọc bến đen bóng. Lau vàng xám nghiêng vào nhau, tiếng nước vỗ nghe gần như tiếng thì thầm."
     }
    },
    {
     "id": "xom_bang",
